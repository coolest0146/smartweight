{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "weighhub",
  "version": "0.1.0",
  "identifier": "weighhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [

  {
    "label": "splashscreen",
    "title": "Loading SMART WEIGHHUB",
    "url": "/SplashScreen.html",
    "width": 500,
    "height": 350,
    "decorations": false,
    "center": true,
    "alwaysOnTop": true,
    "backgroundColor": "#001f4d"
  }
]
,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/opencv_world4140.dll",
      "bin/opencv_videoio_ffmpeg4140_64.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
